		},
		"stop": "Hold Escape to cancel",
		"loading": "%1% done",
		"movie/": {
			"title": "Exporting your movie...",
			"caption": "Video export",
			"videosize": "Video size",
			"videosizecustomwidth": "W",
			"videosizecustomheight": "H",
			"videosizecustomkeepaspectratio": "Keep aspect ratio",
			"format": "Format",
			"format/": {
				"mp4": "MP4",
				"webmp4": "MP4 (web)",
				"webscrub": "MP4 (web · scrollytelling)",
				"mov": "MOV",
				"wmv": "WMV",
				"png": "PNG sequence"
			},
			"webtip": "Web presets keep the project resolution and the same quality as the MP4 export (CRF 16, H.264 High, 4:2:0 BT.709) and add what a browser needs: the index up front for instant streaming and a clean keyframe layout. Bit rate is not used: quality is constant.",
			"scrubgop": "Scrub precision",
			"scrubgop/": {
				"1": "Every frame (all-intra) — safest",
				"2": "Every 2 frames",
				"5": "Every 5 frames — smallest file"
			},
			"scrubgoptip": "How often a keyframe is written. Scroll-driven video jumps to arbitrary frames, so a keyframe on every frame is the only setting that seeks exactly in every browser (Firefox included) — at the cost of a bigger file. Audio is not included in this mode.",
			"videoquality": "Video quality",
			"videoquality/": {
				"verylow": "Very low",
				"low": "Low",
				"medium": "Medium",
				"high": "High",
				"best": "Best",
				"custom": "Custom"
			},
			"bitrate": "Bit rate",
			"framerate": "Framerate",
			"framerate/": {
				"custom": "Custom"
			},
			"framespersecond": "Frames per second",
			"includeaudio": "Include audio",
			"removebackground": "Remove background",
			"blendmodewarning": "Custom blend modes on objects may not render correctly.",
			"renderselection": "Render only selection",
			"renderselectiontip": "Draws only the objects selected in the timeline. Everything else (scenery, props, the infinite ground) stops being drawn but stays in the scene: it keeps casting its shadows, occluding and bouncing light onto the subject, exactly like in the full render. Its pixels are left fully transparent instead. IMPORTANT: this only removes OBJECTS. To also drop the project's sky you must tick \"Remove background\" as well — with this box alone the selection still comes out over the sky. Animated transparency only exists in the PNG sequence format; the video encoders have no alpha channel, so with MP4/MOV/WMV the selection is simply rendered over the background. This is NOT the same as hiding objects with the eye: a hidden object leaves the scene and stops lighting the subject. Tip: select the character's root (not just its Body) so the whole rig is included. Raster engines: an object placed in FRONT of the selection no longer hides it and will show through; use the Cinema engine when something overlaps the subject.",
			"range": "Frame range",
			"rangefrom": "From",
			"rangeto": "To",
			"rangecount": "%1 of %2 frames will be written.",
			"rangeregion": "A region is marked in the timeline, so only that part will be exported. Untick it there, or use Frame range to set the exact frames.",
			"farwarn": "Because of %1 keyframe(s) far past the rest of the animation, this export writes %3 images, up to frame %4. Nothing animates after output frame %2: not one of those keyframes changes a single value. Tick Frame range to write only the part you want.",
			"farshow": "Show those keyframes",
			"includehidden": "Include hidden objects",
			"highquality": "High quality rendering",
			"watermark": "Show watermark",
			"save": "Export video"
		},
		"image/": {
			"title": "Exporting your image...",
			"caption": "Image export",
			"imagesize": "Image size",
			"imagesizecustomwidth": "W",
			"imagesizecustomheight": "H",
			"imagesizecustomkeepaspectratio": "Keep aspect ratio",
			"includehidden": "Include hidden objects",
			"removebackground": "Remove background",
			"blendmodewarning": "Custom blend modes on objects may not render correctly.",
			"renderselection": "Render only selection",
			"renderselectiontip": "Draws only the objects selected in the timeline. Everything else (scenery, props, the infinite ground) stops being drawn but stays in the scene: it keeps casting its shadows, occluding and bouncing light onto the subject, exactly like in the full render. Its pixels are left fully transparent instead, so together with \"Remove background\" you get a cut-out with perfect edges made by the renderer itself: it knows what is background even in an enclosed pocket that never touches the border of the image, which is the case no post-processing cut-out tool can solve. This is NOT the same as hiding objects with the eye: a hidden object leaves the scene and stops lighting the subject. Tip: select the character's root (not just its Body) so the whole rig is included. The contact shadow the subject casts on the floor goes away with the floor; if you want it as a separate layer, use \"Parallax layers: By selection\" instead. The subject keeps exactly the same light as in the full render; with the Cinema engine the only difference is render noise, which fades as you raise the samples. With the raster engines the shadows are kept exactly, but the screen-space effects (ambient occlusion and indirect light) cannot see what is not drawn, so the subject can come out a fraction of a percent different — and an object placed in FRONT of the selection no longer hides it, so it will show through; use the Cinema engine when something overlaps the subject.",
			"renderselectiondisabledtip": "\"Render only selection\" is unavailable while \"Parallax layers\" is set: that mode already decides what is drawn in each pass. Set Parallax layers back to Off to use it.",
			"highquality": "High quality rendering",
			"watermark": "Show watermark",
			"parallaxlayers": "Parallax layers",
			"parallaxlayerstip": "Renders the shot three times and saves three files: _full, _background (the selected objects turn invisible to the camera, so the plate keeps their shadows and bounce light) and _subject (everything else turns MATTE, occluding the camera instead of turning invisible, and the background is removed, so the subjects keep the light of the world on a transparent film with a clean cutout where the scenery blocked them). Ready to stack in a web parallax.",
			"parallaxlayersdepthtip": "Slices the shot into N layers by DISTANCE, seeing through whatever is in front, so each layer brings back what was hidden behind it. Works with floors and monolithic imported worlds too, because it cuts by depth, not by object. Each layer is a full render: N layers take about N times as long as a single render. One click saves _full, _layer00.._layerNN (00 = farthest, stack them in that order with a normal 'over'), _depth.png/_depth.json and _layers.json with the depth, the parallax factor and the camera of every layer. Requires the Cinema render engine.",
			"parallaxn": "Layers (2-12)",
			"parallaxnauto": "Auto (let the depth map decide)",
			"parallaxnautotip": "Reads the shot's depth histogram and cuts only where there is a real gap between groups of geometry, so a character never gets sliced through the middle. The number of layers is whatever the scene actually has (1-12). Untick to force an exact number instead.",
			"parallaxbackdrop": "Ground and large objects in their own back layer (selection mode only)",
			"parallaxlayers/": {
				"off": "Off",
				"selection": "By selection",
				"depth": "By depth (auto)"
			},
			"depthpass": "Depth pass (UltraFlame)",
			"depthpasstip": "Also saves <name>_depth.png: a grayscale depth map of the shot (white = near, black = far, sky = black; brightness is proportional to 1/distance, which is exactly how much things shift in a parallax move) plus <name>_depth.json with the near/far distances and the reconstruction formula. The map is taken with a sharp pinhole probe, so it stays crisp even when the image uses depth of field. With parallax layers it is saved once, for the full scene. Requires the Cinema render engine.",
			"whitedetails": "White details",
			"whitedetailstip": "Paints a few long, tapered white highlight strokes along the highest-contrast edges of the subject, the way they are hand-painted. Two editable layers are always saved next to the export: <name>_whitedetails.png (pure white strokes) and <name>_wdcurvas.png (a subtle curves-style lift of the subject's edge band). Density sets how many strokes, Width their peak thickness. Light angle is in degrees (135 = upper-left, the usual convention for hand-painted highlights); use -1 to follow the scene's sun instead. With the Cinema engine and parallax layers, occlusion edges (like a cape crossing in front of a shaded arm) are picked up automatically using the shot's depth pass.",
			"whitedetailsdensity": "Density",
			"whitedetailswidth": "Width (peak)",
			"whitedetailsangle": "Light angle",
			"whitedetailsparams": "White details settings",
			"whitedetailserror": "White details failed (see log); layers were saved",
			"whitedetailsdisabledtip": "White details needs a cut-out subject: it reads the silhouette from the alpha channel. Turn on 'Remove background', or pick a 'Parallax layers' mode, and this option becomes available.",
			"whitedetailsempty": "White details found no cut-out subject: the layer came out empty (see log)",
			"whitedetailsbgoff": "White details ran without the background layer (its size didn't match the shot; see log) -- occlusion edges from the depth pass are unaffected, but background contrast is off",
			"whitedetailsdepthoff": "White details ran without the depth pass (its size didn't match the shot; see log) -- occlusion edges are skipped for this export",
			"save": "Export image",
			"cancel": "Cancel"
		}
	},
	"upgrade/": {
		"caption": "Upgrade",
		"info": "You are currently using the trial version of Mine-imator. To unlock more advanced features, get an upgrade key from the link below, and enter it here.",
		"page0": "Watermark can be customized.",
		"page1": "Unlock \"Advanced mode\" and get access to all available features.",
		"page2": "Customize your own render settings in projects.",
