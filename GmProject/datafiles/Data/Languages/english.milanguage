		},
		"timeleft": "%1 remaining",
		"timeleft/": {
			"and": "and",
			"hour": "%1 hour",
			"hours": "%1 hours",
			"minute": "%1 minute",
			"minutes": "%1 minutes",
			"second": "%1 second",
